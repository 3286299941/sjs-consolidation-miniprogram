/* app.wxss —— 全局样式与公用类，样式尺寸一律 rpx */
page {
  --color-primary: #1f6feb;
  --color-primary-light: #eaf2ff;
  --color-success: #07b87a;
  --color-warning: #f59a23;
  --color-danger: #e34d59;
  --color-text: #1f2733;
  --color-text-2: #6b7484;
  --color-text-3: #9a9fa8;
  --color-bg: #f4f6f9;
  --color-card: #ffffff;
  --color-line: #edf0f4;
  --radius: 16rpx;

  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: var(--color-text, #1f2733);
  background-color: var(--color-bg, #f4f6f9);
  box-sizing: border-box;
}

view, text, image, input, textarea, button { box-sizing: border-box; }

.page { min-height: 100vh; padding: 24rpx 24rpx 48rpx; }
.card {
  background: var(--color-card, #fff);
  border-radius: var(--radius, 16rpx);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 39, 51, 0.04);
}
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.col { display: flex; flex-direction: column; }
.flex-1 { flex: 1; min-width: 0; }
.gap-8 { margin-right: 8rpx; }
.gap-16 { margin-right: 16rpx; }

.title { font-size: 32rpx; font-weight: 600; }
.subtitle { font-size: 26rpx; color: var(--color-text-2, #6b7484); }
.muted { font-size: 24rpx; color: var(--color-text-3, #9a9fa8); }
.strong { font-weight: 600; }

.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
}
.tag-blue { background: #eaf2ff; color: #1f6feb; }
.tag-green { background: #e6f8f1; color: #07a36d; }
.tag-orange { background: #fff3e0; color: #d98209; }
.tag-red { background: #fdecee; color: #d93644; }
.tag-gray { background: #f1f3f6; color: #6b7484; }

.btn-primary {
  background: var(--color-primary, #1f6feb);
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 88rpx;
  height: 88rpx;
  text-align: center;
  border: none;
}
.btn-primary::after { border: none; }
.btn-primary[disabled] { opacity: 0.5; }
.btn-ghost {
  background: #ffffff;
  color: var(--color-primary, #1f6feb);
  border: 2rpx solid var(--color-primary, #1f6feb);
  border-radius: 12rpx;
  height: 80rpx;
  line-height: 76rpx;
  font-size: 28rpx;
}
.btn-ghost::after { border: none; }

.divider { height: 2rpx; background: var(--color-line, #edf0f4); margin: 24rpx 0; }

/* 骨架屏 */
.skeleton { background: linear-gradient(90deg, #f0f2f5 25%, #e6e9ee 37%, #f0f2f5 63%); background-size: 400% 100%; animation: shimmer 1.4s ease infinite; }
@keyframes shimmer { 0% { background-position: 100% 50%; } 100% { background-position: 0 50%; } }

.safe-bottom { padding-bottom: constant(safe-area-inset-bottom); padding-bottom: env(safe-area-inset-bottom); }
