.empty { display: flex; flex-direction: column; align-items: center; padding: 96rpx 24rpx; }
.empty-circle {
  width: 128rpx; height: 128rpx; border-radius: 50%;
  background: #f1f3f6; display: flex; align-items: center; justify-content: center;
  margin-bottom: 24rpx;
}
.empty-mark { font-size: 60rpx; color: #b6bdc8; line-height: 1; }
.empty-text { font-size: 26rpx; color: #9a9fa8; }
.empty-btn {
  margin-top: 32rpx; padding: 12rpx 40rpx; border: 2rpx solid #1f6feb;
  color: #1f6feb; border-radius: 999rpx; font-size: 26rpx;
}
