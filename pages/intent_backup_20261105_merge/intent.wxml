<view class="page">
  <view class="head-card">
    <text class="title">本周怎么发？</text>
    <text class="subtitle">先选发货方式，再选货物范围；仓库据此安排周四~周六打包。</text>
    <text wx:if="{{zipCode}}" class="muted">归属邮编：{{zipCode}}</text>
  </view>

  <view wx:if="{{!bound && !loading}}" class="card">
    <text class="subtitle">需先绑定仓库客户身份，才能查看并确认发货意向。</text>
    <button class="btn-primary mt" bindtap="goBind">去绑定</button>
  </view>

  <block wx:elif="{{!loading}}">
    <!-- 待确认件数（始终显示） -->
    <text wx:if="{{pendingCount}}" class="muted tip-inline">本周待确认 {{pendingCount}} 件</text>

    <!-- 本周批次（只读展示，仅当有未锁定批次时才显示） -->
    <view wx:if="{{weekBatch}}" class="card">
      <text class="section-label">本周发往批次</text>
      <view class="batch-head">
        <text class="title">{{weekBatch.batch_no}}</text>
        <text class="muted">（邮编 {{weekBatch.zip_code}}）</text>
      </view>
    </view>

    <!-- ① 配送方式（三大类） -->
    <text class="section-label">① 选择发货方式</text>
    <view class="delivery-list">
      <view
        wx:for="{{deliveryOptions}}"
        wx:key="key"
        wx:for-item="opt"
        class="delivery-item {{deliveryType === opt.key ? 'delivery-on' : ''}} {{confirmed ? 'opt-locked' : ''}}"
        data-key="{{opt.key}}"
        bindtap="onPickDelivery"
      >
        <view class="row-between">
          <text class="delivery-label">{{opt.label}}</text>
          <view class="radio {{deliveryType === opt.key ? 'radio-on' : ''}}"></view>
        </view>
        <text wx:if="{{opt.key === 'direct'}}" class="delivery-desc">发到您的个人地址，无需批次（VIP 单独发货）</text>
      </view>
    </view>

    <!-- 单独地址：说明 + 地址表单 -->
    <view wx:if="{{deliveryType === 'direct'}}" class="card">
      <view class="notice-mini">
        未打包的包裹没有重量信息：满 {{minWeight}} kg 由仓库打包称重后核验；
        不足 {{minWeight}} kg 会转为拼邮发货，或多件合并后再发。
      </view>
      <input
        class="form-input mt-s"
        value="{{addrName}}"
        placeholder="收件人姓名"
        data-field="addrName"
        bindinput="onAddrInput"
      />
      <input
        class="form-input mt-s"
        value="{{addrPhone}}"
        placeholder="联系电话"
        data-field="addrPhone"
        bindinput="onAddrInput"
      />
      <input
        class="form-input mt-s"
        value="{{addrLine}}"
        placeholder="详细收货地址"
        data-field="addrLine"
        bindinput="onAddrInput"
      />
      <input
        class="form-input mt-s"
        value="{{addrZip}}"
        placeholder="邮编"
        data-field="addrZip"
        bindinput="onAddrInput"
      />
    </view>

    <!-- 暂不发货说明 -->
    <view wx:if="{{deliveryType === 'none'}}" class="sub-box">
      <text class="sub-line">本周不安排发货，货物继续留在货架保持「已入库」，下周批次仍可再选。</text>
    </view>

    <!-- ② 货物范围（仅拼邮 / 单独地址） -->
    <block wx:if="{{deliveryType && deliveryType !== 'none'}}">
      <text class="section-label">② 选择货物范围</text>
      <view class="scope-row">
        <view
          wx:for="{{cargoOptions}}"
          wx:key="key"
          wx:for-item="opt"
          class="scope-item {{cargoScope === opt.key ? 'scope-on' : ''}} {{confirmed ? 'opt-locked' : ''}}"
          data-key="{{opt.key}}"
          bindtap="onPickScope"
        >
          <text class="scope-label">{{opt.label}}</text>
          <text class="scope-desc">{{opt.desc}}</text>
        </view>
      </view>
    </block>

    <!-- ③ 客户备注：写 shipment_intents.remark，操作端读表即同步 -->
    <text class="section-label">③ 备注（选填）</text>
    <view class="remark-box">
      <textarea
        class="remark-input"
        value="{{remark}}"
        placeholder="如：易碎轻放 / 某件先不发，仓库操作端会看到"
        maxlength="{{remarkMax}}"
        data-key="remark"
        bindinput="onRemarkInput"
      />
      <text class="remark-count">{{remark.length}}/{{remarkMax}}</text>
    </view>

    <button
      class="btn-primary mt"
      disabled="{{!deliveryType || confirmed || submitting}}"
      bindtap="onSubmit"
    >{{submitting ? '提交中...' : (intent ? '更新意向' : '提交意向')}}</button>

    <view wx:if="{{intent}}" class="intent-state {{confirmed ? 'state-ok' : ''}}">
      {{confirmed ? '仓库已确认：' : '已提交：'}}{{intentSummary}}（{{confirmed ? '不可再修改' : '等待仓库确认，可再次修改'}}）
    </view>

    <view class="card tip-card">
      <text class="strong">提请注意</text>
      <view class="tip-line">· 拼邮：自动归入本周该邮编的未锁定批次，发到集运地址后自行提货。</view>
      <view class="tip-line">· 单独地址：VIP 单独发货，无需批次，满 {{minWeight}} kg 由仓库打包称重后核验。</view>
      <view class="tip-line">· 本周暂不发货的货继续留在货架，下次批次仍可再选。</view>
      <view class="tip-line">· 备注会同步到仓库操作端，管理端确认后本批次意向锁定。</view>
    </view>
  </block>

  <view wx:else class="card"><text class="muted">加载中…</text></view>
</view>
