.head-card {
  background: #ffffff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 24rpx;
  display: flex; flex-direction: column;
}
.head-card .subtitle { margin: 12rpx 0 8rpx; line-height: 1.7; }
.sk-block { height: 320rpx; border-radius: 16rpx; }
.batch-card { padding: 28rpx; }
.count-row { display: flex; margin: 24rpx 0; }
.count-box {
  flex: 1; background: #f7f9fc; border-radius: 12rpx; padding: 16rpx;
  display: flex; flex-direction: column; align-items: center; margin-right: 16rpx;
}
.count-box:last-child { margin-right: 0; }
.count-num { font-size: 36rpx; font-weight: 600; color: #1f6feb; }
.opt-grid { display: flex; flex-wrap: wrap; }
.opt {
  width: calc(50% - 10rpx); margin-bottom: 20rpx; padding: 20rpx;
  border: 2rpx solid #e6eaf0; border-radius: 12rpx;
  display: flex; flex-direction: column;
}
.opt:nth-child(odd) { margin-right: 20rpx; }
.opt-on { border-color: #1f6feb; background: #eaf2ff; }
.opt-locked { opacity: 0.55; }
.opt-label { font-size: 28rpx; font-weight: 600; color: #1f2733; }
.opt-on .opt-label { color: #1f6feb; }
.opt-desc { font-size: 22rpx; color: #9a9fa8; margin-top: 8rpx; line-height: 1.5; }
.intent-state {
  background: #f7f9fc; border-radius: 10rpx; padding: 16rpx;
  font-size: 24rpx; color: #6b7484; line-height: 1.6;
}
.state-ok { background: #e6f8f1; color: #07a36d; }
.tip-card { background: #fffaf1; }
.tip-line { font-size: 24rpx; color: #8a6a35; line-height: 1.9; margin-top: 8rpx; }
.mt { margin-top: 24rpx; }

/* ---------- 第四轮：三层发货意向 ---------- */
.section-label {
  display: block; font-size: 26rpx; font-weight: 600; color: #1f2733;
  margin: 28rpx 0 16rpx;
}
.delivery-item {
  border: 2rpx solid #e6eaf0; border-radius: 14rpx; padding: 22rpx;
  margin-bottom: 16rpx; background: #ffffff;
}
.delivery-on { border-color: #1f6feb; background: #f5f9ff; }
.delivery-label { font-size: 29rpx; font-weight: 600; color: #1f2733; }
.delivery-on .delivery-label { color: #1f6feb; }
.delivery-desc { display: block; font-size: 23rpx; color: #9a9fa8; margin-top: 8rpx; line-height: 1.5; }
.radio {
  width: 32rpx; height: 32rpx; border-radius: 50%;
  border: 2rpx solid #c9cfd8; flex-shrink: 0;
}
.radio-on { border-color: #1f6feb; background: #1f6feb; box-shadow: inset 0 0 0 6rpx #ffffff; }
.sub-box {
  margin-top: 18rpx; padding: 18rpx; background: #ffffff;
  border-radius: 10rpx; border: 2rpx dashed #dbe4f3;
}
.sub-title { font-size: 24rpx; color: #1f6feb; font-weight: 600; }
.sub-line { display: block; font-size: 23rpx; color: #6b7484; line-height: 1.7; margin-top: 4rpx; }
.warn-line { color: #d98209; }
.notice-mini {
  font-size: 23rpx; color: #d98209; background: #fff8ec;
  padding: 12rpx 16rpx; border-radius: 8rpx; line-height: 1.6;
}
.weight-row { display: flex; align-items: baseline; margin-bottom: 12rpx; }
.weight-num { font-size: 34rpx; font-weight: 600; margin-right: 10rpx; }
.weight-num.ok { color: #07a36d; }
.weight-num.warn { color: #d98209; }
.form-input {
  background: #f7f9fc; border-radius: 10rpx; height: 78rpx;
  padding: 0 20rpx; font-size: 26rpx;
}
.mt-s { margin-top: 12rpx; }
.scope-row { display: flex; }
.scope-item {
  flex: 1; border: 2rpx solid #e6eaf0; border-radius: 12rpx;
  padding: 18rpx 12rpx; margin-right: 12rpx; text-align: center;
}
.scope-item:last-child { margin-right: 0; }
.scope-on { border-color: #1f6feb; background: #eaf2ff; }
.scope-label { display: block; font-size: 25rpx; font-weight: 600; color: #1f2733; }
.scope-on .scope-label { color: #1f6feb; }
.scope-desc { display: block; font-size: 21rpx; color: #9a9fa8; margin-top: 6rpx; line-height: 1.4; }
.tip-inline { display: block; font-size: 22rpx; margin-top: 12rpx; line-height: 1.6; }

/* 第五轮：客户备注 */
.remark-box {
  position: relative; background: #f7f9fc; border-radius: 12rpx;
  padding: 20rpx 20rpx 40rpx;
}
.remark-input {
  width: 100%; height: 150rpx; font-size: 26rpx; line-height: 1.6;
  color: #1f2733;
}
.remark-count {
  position: absolute; right: 20rpx; bottom: 14rpx;
  font-size: 22rpx; color: #9a9fa8;
}
