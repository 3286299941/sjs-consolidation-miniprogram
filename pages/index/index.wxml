<view class="page">
  <!-- 管理员客户端视角提示条 -->
  <view wx:if="{{clientView}}" class="admin-banner" bindtap="backToAdmin">
    <text class="admin-banner-text">管理员视角：正在预览客户端</text>
    <text class="admin-banner-link">返回管理端 ›</text>
  </view>

  <!-- 身份卡 -->
  <view class="hero">
    <view class="row-between">
      <view class="col">
        <text class="hero-greeting">{{bound ? '您好，' + (profile.customer.name || '客户') : '欢迎使用速捷供应链'}}</text>
        <text wx:if="{{bound}}" class="hero-sub">客户号 {{profile.customer.customer_no}} ｜ 邮编 {{profile.customer.zip_code}}</text>
        <text wx:else class="hero-sub">绑定仓库客户名后即可查看货物、确认发货</text>
      </view>
      <view wx:if="{{bound && profile.customer.is_vip}}" class="vip">VIP</view>
    </view>
  </view>

  <!-- 未绑定引导 -->
  <view wx:if="{{!bound && !loading}}" class="card bind-tip">
    <view class="title">还差一步：绑定客户身份</view>
    <text class="subtitle">用客户名、客户号或条码三选一即可提交绑定申请，仓库审核通过后开通。</text>
    <button class="btn-primary bind-btn" bindtap="goBind">去绑定</button>
  </view>

  <!-- 概览三宫格 -->
  <view wx:if="{{bound}}" class="stat-row">
    <view class="stat-item" bindtap="goMyPackages">
      <text class="stat-num">{{stats.inStock}}</text>
      <text class="stat-label">在库包裹</text>
    </view>
    <view class="stat-item" bindtap="goIntent">
      <text class="stat-num">{{stats.toDecide}}</text>
      <text class="stat-label">待决策件数</text>
    </view>
    <view class="stat-item" bindtap="goIntent">
      <text class="stat-num">{{stats.pendingBatches}}</text>
      <text class="stat-label">待确认批次</text>
    </view>
  </view>

  <!-- 待决策批次 -->
  <view wx:if="{{bound}}" class="card">
    <view class="row-between">
      <text class="title">本周待决策批次</text>
      <text class="link" bindtap="goIntent">全部 ›</text>
    </view>
    <view wx:if="{{loading}}" class="skeleton sk-line"></view>
    <block wx:elif="{{pendingBatches.length > 0}}">
      <view wx:for="{{pendingBatches}}" wx:key="id" class="batch-row" bindtap="goIntent">
        <view class="col flex-1">
          <text class="strong">{{item.batch_no}} ｜ 邮编 {{item.zip_code}}</text>
          <text class="muted">{{item.counts_hidden ? '待确认 ' + item.package_count + ' 件' : '普货 ' + item.normal_count + ' 件 · 敏货 ' + item.sensitive_count + ' 件'}}</text>
        </view>
        <view class="tag {{item.intent ? 'tag-green' : 'tag-orange'}}">{{item.intent ? '已提交意向' : '待提交'}}</view>
      </view>
    </block>
    <empty-state wx:else text="当前没有待决策批次" mark="✓" />
  </view>

  <!-- 我的账单：仅展示管理端已派发的批次账单 -->
  <view wx:if="{{bound && myBills.length > 0}}" class="card">
    <view class="row-between">
      <text class="title">我的账单</text>
    </view>
    <view wx:for="{{myBills}}" wx:key="batch_id" class="bill-row" data-bid="{{item.batch_id}}" bindtap="goBill">
      <view class="col flex-1">
        <text class="strong">{{item.batch_no}}</text>
        <text class="muted">派发 {{item.dispatched_at}}</text>
      </view>
      <view class="bill-amt">{{currency}}{{item.total_freight}}</view>
      <text class="tag tag-green">查看 ›</text>
    </view>
  </view>

  <!-- 快捷入口：改用高清 PNG 图标，避免字符图标在高分屏上发虚 -->
  <view class="card">
    <text class="title">常用功能</text>
    <view class="quick-grid">
      <view class="quick-item" bindtap="goMyPackages">
        <image class="quick-icon" src="/assets/icons/box-active.png" mode="aspectFit" />
        <text>我的货物</text>
      </view>
      <view class="quick-item" bindtap="goIntent">
        <image class="quick-icon" src="/assets/icons/send-active.png" mode="aspectFit" />
        <text>发货确认</text>
      </view>
      <view class="quick-item" bindtap="goBind">
        <image class="quick-icon" src="/assets/icons/bind-active.png" mode="aspectFit" />
        <text>客户绑定</text>
      </view>
      <view class="quick-item" bindtap="goTracks">
        <image class="quick-icon" src="/assets/icons/send-active.png" mode="aspectFit" />
        <text>物流轨迹</text>
      </view>
      <view wx:if="{{isAdmin}}" class="quick-item" bindtap="goAdmin">
        <image class="quick-icon" src="/assets/icons/admin-active.png" mode="aspectFit" />
        <text>管理端</text>
      </view>
    </view>
  </view>

  <!-- 业务规则说明：与操作端周流程对齐 -->
  <view class="card rule-card">
    <text class="title">每周发货节奏</text>
    <view class="rule-line">① 周一 ~ 周三：快递入库，暂存在货架</view>
    <view class="rule-line">② 周三下午：按邮编建立当周批次</view>
    <view class="rule-line">③ 周四 ~ 周六：仓库按意向打包发货</view>
    <view class="rule-line">④ 不想发的货可以继续攒着，保持「已入库」</view>
  </view>
</view>
