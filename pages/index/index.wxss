.hero {
  background: linear-gradient(135deg, #1f6feb, #4b91ff);
  border-radius: 20rpx; padding: 36rpx 30rpx; margin-bottom: 24rpx;
  color: #ffffff;
}

/* 管理员客户端视角提示条（深色，与客户端亮色系区分） */
.admin-banner {
  display: flex; align-items: center; justify-content: space-between;
  background: #16243f; color: #ffffff;
  border-radius: 16rpx; padding: 22rpx 26rpx; margin-bottom: 24rpx;
}
.admin-banner-text { font-size: 26rpx; opacity: 0.9; }
.admin-banner-link { font-size: 26rpx; color: #ffd66b; font-weight: 600; }

.hero-greeting { font-size: 36rpx; font-weight: 600; }
.hero-sub { font-size: 24rpx; opacity: 0.85; margin-top: 12rpx; }
.vip {
  background: rgba(255,255,255,0.22); border: 2rpx solid rgba(255,255,255,0.6);
  padding: 6rpx 18rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 600;
}
.bind-tip .subtitle { display: block; margin: 16rpx 0 24rpx; line-height: 1.7; }
.bind-btn { margin-top: 8rpx; }

.stat-row { display: flex; background: #ffffff; border-radius: 16rpx; padding: 28rpx 0; margin-bottom: 24rpx; }
.stat-item { flex: 1; display: flex; flex-direction: column; align-items: center; border-right: 2rpx solid #edf0f4; }
.stat-item:last-child { border-right: none; }
.stat-num { font-size: 44rpx; font-weight: 600; color: #1f6feb; line-height: 1.2; }
.stat-label { font-size: 24rpx; color: #6b7484; margin-top: 8rpx; }

.link { font-size: 26rpx; color: #1f6feb; }
.batch-row {
  display: flex; align-items: center; padding: 24rpx 0;
  border-bottom: 2rpx solid #edf0f4;
}
.batch-row:last-child { border-bottom: none; }
.batch-row .muted { margin-top: 8rpx; }
.bill-row {
  display: flex; align-items: center; padding: 22rpx 0;
  border-bottom: 2rpx solid #edf0f4;
}
.bill-row:last-child { border-bottom: none; }
.bill-row .muted { margin-top: 8rpx; }
.bill-amt { font-size: 30rpx; font-weight: 700; color: #f59e0b; margin-right: 16rpx; }
.sk-line { height: 80rpx; border-radius: 12rpx; margin-top: 24rpx; }

.quick-grid { display: flex; margin-top: 24rpx; }
.quick-item { flex: 1; display: flex; flex-direction: column; align-items: center; font-size: 24rpx; color: #6b7484; }
/* 高清 PNG 图标：固定尺寸，避免 image 组件默认 320x240 撑开布局 */
.quick-icon {
  width: 80rpx; height: 80rpx; border-radius: 20rpx; background: #eaf2ff;
  padding: 12rpx; margin-bottom: 12rpx;
}
.quick-mark {
  width: 80rpx; height: 80rpx; border-radius: 20rpx; background: #eaf2ff;
  color: #1f6feb; font-size: 40rpx; display: flex; align-items: center;
  justify-content: center; margin-bottom: 12rpx;
}
.rule-line { font-size: 26rpx; color: #4a5462; line-height: 2; margin-top: 8rpx; }
