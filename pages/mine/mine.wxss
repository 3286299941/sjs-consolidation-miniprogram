.profile-card { display: flex; align-items: center; }
.avatar {
  width: 96rpx; height: 96rpx; border-radius: 50%; background: #eaf2ff;
  color: #1f6feb; font-size: 36rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center; margin-right: 24rpx;
  flex-shrink: 0;
}
.profile-card .muted { margin-top: 8rpx; }
.info-card { padding: 8rpx 28rpx; }
.info-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 22rpx 0; border-bottom: 2rpx solid #edf0f4; font-size: 27rpx;
}
.info-row:last-child { border-bottom: none; }
.info-label { color: #6b7484; }
.info-value { color: #1f2733; font-weight: 500; }
.cell-card { padding: 8rpx 28rpx; }
.card-head { font-size: 24rpx; color: #9a9fa8; padding: 24rpx 0 8rpx; }
.cell {
  display: flex; align-items: center; justify-content: space-between;
  width: 100%; min-height: 92rpx; padding: 24rpx 0; margin: 0;
  border: none; border-bottom: 2rpx solid #edf0f4; border-radius: 0;
  background: #ffffff; color: #1f2733; font-size: 28rpx;
  text-align: left; line-height: 1.4;
}
.cell::after { border: none; }
.cell:last-child { border-bottom: none; }
.cell-arrow { color: #b6bdc8; font-size: 36rpx; }
.logout-btn { margin-top: 8rpx; }
.version { text-align: center; font-size: 22rpx; color: #b6bdc8; padding: 40rpx 0 24rpx; }

/* 微信头像填充 */
.avatar-img { width: 100%; height: 100%; border-radius: 50%; }

/* 完善微信资料卡 */
.wechat-card { display: flex; flex-direction: column; gap: 12rpx; }
.wechat-card .title { font-size: 30rpx; font-weight: 600; color: #1f2329; }
.wechat-card .subtitle { font-size: 24rpx; color: #8a8f99; }
.btn-avatar {
  margin-top: 8rpx; background: #1f6feb; color: #fff; font-size: 26rpx;
  border-radius: 12rpx; line-height: 2.6;
}
.nick-input {
  margin-top: 8rpx; height: 72rpx; padding: 0 20rpx; background: #f4f6f9;
  border-radius: 12rpx; font-size: 26rpx; color: #1f2733;
}
