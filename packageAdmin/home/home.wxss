.page { padding: 24rpx 24rpx 48rpx; background: #eef1f6; min-height: 100vh; }

/* 深色顶栏：明确区别于客户端亮蓝 hero */
.hero {
  display: flex; align-items: center; justify-content: space-between;
  background: linear-gradient(135deg, #16243f, #243b5e);
  border-radius: 24rpx; padding: 40rpx 32rpx; margin-bottom: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(22, 36, 63, 0.28);
}
.hero-title { font-size: 42rpx; font-weight: 700; color: #fff; letter-spacing: 2rpx; }
.hero-sub { margin-top: 10rpx; font-size: 24rpx; color: rgba(255, 255, 255, 0.7); }
.hero-badge {
  font-size: 22rpx; color: #9ec1ff; border: 2rpx solid rgba(158, 193, 255, 0.45);
  border-radius: 999rpx; padding: 8rpx 20rpx; background: rgba(158, 193, 255, 0.12);
}
/* 右上角竖排：徽标 + 客户端视角切换 */
.hero-right { display: flex; flex-direction: column; align-items: flex-end; gap: 12rpx; }
.hero-switch {
  font-size: 22rpx; color: #ffd66b; border: 2rpx solid rgba(255, 214, 107, 0.5);
  border-radius: 999rpx; padding: 8rpx 20rpx; background: rgba(255, 214, 107, 0.1);
}

/* 全局 KPI 网格 */
.kpi-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-bottom: 24rpx; }
.kpi-card {
  background: #fff; border-radius: 18rpx; padding: 28rpx 24rpx;
  display: flex; flex-direction: column; gap: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(22, 36, 63, 0.06);
}
.kpi-num { font-size: 44rpx; font-weight: 700; color: #16243f; line-height: 1.1; }
.kpi-label { font-size: 24rpx; color: #8a93a3; }
.kpi-sub { font-size: 22rpx; color: #e8862b; margin-top: 6rpx; }
.kpi-card.accent .kpi-num { color: #e8862b; }

/* 骨架 */
.skeleton { background: linear-gradient(90deg, #f0f2f5 25%, #e6e9ee 37%, #f0f2f5 63%); background-size: 400% 100%; animation: shimmer 1.4s ease infinite; }
@keyframes shimmer { 0% { background-position: 100% 50%; } 100% { background-position: 0 50%; } }
.sk-kpi { height: 220rpx; border-radius: 18rpx; }

.card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 18rpx rgba(22, 36, 63, 0.05); }
.section .title { font-size: 31rpx; font-weight: 600; color: #16243f; }
.sec-head { margin-bottom: 22rpx; }

/* 待办网格 */
.todo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.todo-item {
  border-radius: 16rpx; padding: 26rpx 24rpx; background: #f4f6fa;
  display: flex; flex-direction: column; gap: 8rpx;
}
.todo-hot { background: #fff3e8; }
.todo-count { font-size: 40rpx; font-weight: 700; color: #515b6b; }
.todo-hot .todo-count { color: #e8862b; }
.todo-label { font-size: 24rpx; color: #8a93a3; }

/* 功能入口 */
.entry-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 20rpx; }
.entry { padding: 30rpx 26rpx; background: #f7f9fc; border-radius: 16rpx; }
.entry-hover { opacity: 0.82; transform: translateY(2rpx); }
.entry-title { display: block; font-size: 32rpx; font-weight: 600; color: #16243f; }
.entry-desc { display: block; margin-top: 8rpx; font-size: 22rpx; color: #9aa2b1; line-height: 1.5; }

.notice { font-size: 23rpx; color: #9aa2b1; line-height: 1.7; }
