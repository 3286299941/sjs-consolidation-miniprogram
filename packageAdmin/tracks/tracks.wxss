.page { padding: 24rpx 24rpx 48rpx; background: #eef1f6; min-height: 100vh; }
.hero { background: linear-gradient(135deg, #16243f, #243b5e); border-radius: 24rpx; padding: 36rpx 30rpx; margin-bottom: 24rpx; color: #fff; }
.hero-title { font-size: 40rpx; font-weight: 700; }
.hero-sub { font-size: 23rpx; opacity: 0.8; margin-top: 12rpx; }
.hero-tip { font-size: 22rpx; color: #ffd66b; margin-top: 12rpx; }
.card { background: #fff; border-radius: 18rpx; padding: 26rpx 24rpx; margin-bottom: 18rpx; box-shadow: 0 4rpx 16rpx rgba(22,36,63,0.06); }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.group-head { padding-bottom: 18rpx; border-bottom: 2rpx solid #f0f2f5; margin-bottom: 10rpx; }
.group-name { display: flex; align-items: center; gap: 14rpx; }
.zip { font-size: 30rpx; font-weight: 700; color: #16243f; }
.badge { font-size: 22rpx; padding: 6rpx 20rpx; border-radius: 999rpx; }
.badge-green { background: #e8f7ef; color: #16a34a; }
.badge-red { background: #fdeaea; color: #e23c3c; }
.muted { font-size: 23rpx; color: #8a93a3; }
.sec-label { display: block; font-size: 24rpx; color: #4b5563; margin: 20rpx 0 10rpx; }
/* 固定高度 + 只用水平内边距，避免小程序 input 内容区被垂直 padding 压扁 */
.form-input, .picker { background: #f5f7fa; border-radius: 12rpx; height: 80rpx; line-height: 80rpx; padding: 0 20rpx; font-size: 26rpx; color: #1f2733; box-sizing: border-box; }
.picker { color: #6b7484; }
.preview { margin-top: 24rpx; padding: 20rpx; background: #f7f9fc; border-radius: 12rpx; }
.preview-text { display: block; font-size: 24rpx; color: #16243f; line-height: 1.6; margin-top: 8rpx; }
.notice { font-size: 23rpx; color: #8a93a3; line-height: 1.7; margin-top: 8rpx; }
.btn-primary { background: #3a6df0; color: #fff; border-radius: 14rpx; font-size: 28rpx; }
.btn-primary.mt { margin-top: 10rpx; }
.skeleton { background: #e6e9ee; border-radius: 18rpx; }
.sk-block { height: 300rpx; }

/* 当前物流状态选择器 */
.node-picker { display: flex; align-items: center; justify-content: space-between; color: #16243f; font-weight: 600; background: #eaf0ff; }
.picker-arrow { color: #3a6df0; font-size: 26rpx; }

/* 按节点填写明细 */
.node-title { display: flex; align-items: baseline; gap: 14rpx; margin: 30rpx 0 6rpx; padding-top: 22rpx; border-top: 2rpx solid #f0f2f5; font-size: 27rpx; font-weight: 600; color: #16243f; }
.node-title-sub { font-size: 21rpx; font-weight: 400; color: #9aa2b1; }
.node-row { padding: 18rpx 0; border-bottom: 2rpx solid #f4f6f9; }
.node-row:last-child { border-bottom: none; }
.node-head { display: flex; align-items: center; gap: 12rpx; }
.node-label { font-size: 25rpx; color: #4b5563; }
.node-label.label-current { color: #3a6df0; font-weight: 600; }
.issue-tag { font-size: 20rpx; color: #e8862b; background: #fff4e3; padding: 2rpx 12rpx; border-radius: 999rpx; }
.node-inputs { display: flex; gap: 12rpx; margin-top: 12rpx; }
.form-input.small, .picker.small { height: 68rpx; line-height: 68rpx; padding: 0 16rpx; font-size: 23rpx; }
.picker.small { width: 230rpx; flex: none; color: #9aa2b1; }
.form-input.small { flex: 1; min-width: 0; }
.picker.small.date-on { color: #16243f; }
