.page { padding: 24rpx 24rpx 40rpx; background: #eef1f6; min-height: 100vh; }

.hero {
  background: linear-gradient(135deg, #16243f, #243b5e);
  border-radius: 24rpx; padding: 36rpx 32rpx; margin-bottom: 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(22, 36, 63, 0.28);
}
.hero-title { font-size: 38rpx; font-weight: 700; color: #fff; }
.hero-sub { margin-top: 10rpx; display: block; font-size: 23rpx; color: rgba(255, 255, 255, 0.85); line-height: 1.6; }

.total-card {
  background: #fff; border-radius: 20rpx; padding: 28rpx 24rpx; margin-bottom: 18rpx;
  box-shadow: 0 4rpx 18rpx rgba(31, 42, 60, 0.05);
}
.total-row { display: flex; align-items: center; justify-content: space-between; }
.total-lab { font-size: 28rpx; color: #1f2733; font-weight: 600; }
.total-amt { font-size: 38rpx; font-weight: 700; color: #f59e0b; }
.total-sub { display: flex; gap: 40rpx; margin-top: 12rpx; font-size: 24rpx; color: #9a9fa8; }

.dispatch-row { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; padding-top: 18rpx; border-top: 2rpx solid #f4f6f9; }
.disp-badge { font-size: 23rpx; color: #9a9fa8; }
.disp-badge.on { color: #16a34a; font-weight: 600; }
.dispatch-btn {
  margin: 0; padding: 0 32rpx; height: 60rpx; line-height: 60rpx;
  background: #3a6df0; color: #fff; font-size: 26rpx; border-radius: 999rpx; font-weight: 600;
}
.dispatch-btn::after { border: none; }
.dispatch-btn.recall { background: #fff; color: #dc2626; border: 2rpx solid #f0b4b4; }

.cust-card {
  background: #fff; border-radius: 18rpx; padding: 8rpx 24rpx; margin-bottom: 16rpx;
  box-shadow: 0 4rpx 18rpx rgba(31, 42, 60, 0.05);
}
.cust-name { font-size: 30rpx; font-weight: 700; color: #1f2733; padding: 16rpx 0 8rpx; display: flex; align-items: center; }
.paid-flag { font-size: 20rpx; font-weight: 600; color: #16a34a; background: #e7f6ec; padding: 2rpx 12rpx; border-radius: 999rpx; margin-left: 14rpx; }

.filter-bar { background: #fff; border-radius: 18rpx; padding: 18rpx 20rpx; margin-bottom: 16rpx; display: flex; flex-direction: column; gap: 16rpx; box-shadow: 0 4rpx 18rpx rgba(31, 42, 60, 0.05); }
.seg { display: flex; background: #f1f3f7; border-radius: 999rpx; padding: 4rpx; }
.seg-item { flex: 1; text-align: center; font-size: 25rpx; color: #6b7280; padding: 12rpx 0; border-radius: 999rpx; }
.seg-item.on { background: #3a6df0; color: #fff; font-weight: 600; }
.search-box { display: flex; }
.search-input { flex: 1; background: #f5f7fa; border: 2rpx solid #e2e6ee; border-radius: 12rpx; height: 64rpx; line-height: 64rpx; padding: 0 20rpx; font-size: 26rpx; }
.cust-line { padding: 18rpx 0; border-top: 2rpx solid #f4f6f9; }
.cust-line-top { display: flex; align-items: center; min-width: 0; }
.tag {
  font-size: 22rpx; font-weight: 700; padding: 4rpx 14rpx; border-radius: 999rpx; margin-right: 16rpx;
}
.tag.normal { background: #eaf0ff; color: #3a6df0; }
.tag.sensitive { background: #fef3e2; color: #d97706; }
.cust-meta { font-size: 23rpx; color: #9a9fa8; margin-right: 16rpx; }

.cw-edit { display: flex; align-items: center; margin-right: 16rpx; }
.cw-lab { font-size: 22rpx; color: #8a92a0; margin-right: 8rpx; }
.cw-input {
  width: 110rpx; height: 48rpx; line-height: 48rpx; text-align: center;
  background: #f5f7fa; border: 2rpx solid #e2e6ee; border-radius: 10rpx;
  font-size: 26rpx; color: #1f2733; font-weight: 600;
}
.cw-unit { font-size: 22rpx; color: #8a92a0; margin-left: 6rpx; }

.cust-amt { font-size: 30rpx; font-weight: 700; color: #f59e0b; margin-left: auto; }
.cust-weight-s {
  font-size: 22rpx; color: #8a92a0; line-height: 1.5;
}
.cust-line-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 10rpx; padding: 0 0 14rpx 0; }
.paid-amt { font-size: 22rpx; color: #16a34a; font-weight: 600; }
.cust-dims { margin-top: 10rpx; }
.dim-line {
  font-size: 22rpx; color: #6b7280; line-height: 1.7;
  font-family: Menlo, Consolas, monospace; letter-spacing: 1rpx;
}

.cust-total-row {
  display: flex; align-items: center;
  padding: 18rpx 0 20rpx; border-top: 2rpx solid #eef1f6; margin-top: 4rpx;
}
.cust-total-lab { font-size: 24rpx; color: #6b7280; font-weight: 600; }
.cust-total-amt { font-size: 36rpx; font-weight: 700; color: #f59e0b; margin-left: 16rpx; flex: 1; }

.settle-btn {
  padding: 14rpx 32rpx; background: #3a6df0; color: #fff;
  font-size: 26rpx; border-radius: 999rpx; font-weight: 600;
}
.settle-done { font-size: 24rpx; color: #16a34a; font-weight: 600; }

.empty-hint { padding: 40rpx 24rpx; text-align: center; font-size: 24rpx; color: #9a9fa8; background: #fff; border-radius: 18rpx; }
.hint { display: block; margin-top: 18rpx; font-size: 22rpx; color: #9a9fa8; line-height: 1.6; padding: 0 8rpx; }
.sk-block { height: 220rpx; border-radius: 20rpx; background: #eef1f6; }

/* 尺寸信息推送确认 */
.dim-card {
  background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 18rpx;
  box-shadow: 0 4rpx 18rpx rgba(31, 42, 60, 0.05);
}
.dim-head { display: flex; align-items: center; justify-content: space-between; }
.dim-title { font-size: 28rpx; font-weight: 700; color: #1f2733; }
.dim-badge { font-size: 22rpx; color: #9a9fa8; }
.dim-badge.on { color: #3a6df0; font-weight: 600; }
.dim-progress { display: flex; align-items: center; justify-content: space-between; margin-top: 14rpx; font-size: 24rpx; color: #6b7280; }
.dim-ok { color: #16a34a; font-weight: 600; }
.dim-list { margin-top: 12rpx; border-top: 2rpx solid #f4f6f9; }
.dim-item { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 0; border-bottom: 2rpx solid #f4f6f9; }
.dim-name { font-size: 25rpx; color: #1f2733; }
.dim-flag { font-size: 22rpx; font-weight: 600; padding: 2rpx 14rpx; border-radius: 999rpx; }
.dim-flag.done { color: #16a34a; background: #e7f6ec; }
.dim-flag.pending { color: #d97706; background: #fef3e2; }
.dim-btn {
  margin: 18rpx 0 0; padding: 0; height: 64rpx; line-height: 64rpx;
  background: #3a6df0; color: #fff; font-size: 26rpx; border-radius: 999rpx; font-weight: 600;
}
.dim-btn::after { border: none; }
.dim-btn.recall { background: #fff; color: #dc2626; border: 2rpx solid #f0b4b4; }
.dim-tip { display: block; margin-top: 12rpx; font-size: 22rpx; color: #d97706; line-height: 1.5; }
.dispatch-block {
  margin-top: 14rpx; padding: 14rpx 18rpx; background: #fff4e5; color: #d97706;
  font-size: 23rpx; border-radius: 12rpx; border: 2rpx solid #f6d9a8;
}
