<view class="page">
  <view class="card head-card">
    <text class="title">绑定申请</text>
    <text class="subtitle">待审核 {{pendingCount}} 条。请核对客户档案、客户号 / 条码与预留手机号后 4 位。</text>
  </view>

  <view wx:if="{{loading}}" class="skeleton sk-block"></view>

  <block wx:else>
    <view wx:for="{{list}}" wx:key="id" class="card">
      <view class="row-between">
        <view class="col flex-1">
          <text class="strong">{{item.customer_name}}</text>
          <text class="muted">{{item.customer_no}} · {{item.area || item.address || '区域待补充'}} · 邮编 {{item.zip_code || '—'}}</text>
          <text class="muted">提交时间 {{item.created_at}}</text>
        </view>
        <view class="tag {{item.bind_status === 1 ? 'tag-orange' : (item.bind_status === 2 ? 'tag-green' : 'tag-gray')}}">
          {{item.bind_status === 1 ? '待审核' : (item.bind_status === 2 ? '已通过' : '已驳回')}}
        </view>
      </view>

      <view wx:if="{{item.bind_status === 1}}" class="btn-row">
        <view class="act-btn reject" data-id="{{item.id}}" data-action="reject" bindtap="onAudit">驳回</view>
        <view class="act-btn approve" data-id="{{item.id}}" data-action="approve" bindtap="onAudit">通过</view>
      </view>
      <view wx:elif="{{item.bind_status === 2}}" class="btn-row">
        <view class="act-btn reject" data-id="{{item.id}}" data-action="unbind" bindtap="onAudit">解绑客户</view>
      </view>
    </view>

    <empty-state wx:if="{{list.length === 0}}" text="暂无绑定申请" mark="✓" />
  </block>

  <view class="card notice">
    一个 openid 在 MVP 阶段只绑定一个 customer_id。已绑定的客户如需换绑，点「解绑客户」后由客户重新提交申请即可；解绑同时释放绑定关系。
  </view>
</view>
