.page { padding: 24rpx 24rpx 40rpx; background: #f4f6fb; min-height: 100vh; }

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 18rpx rgba(31, 42, 60, 0.05);
}

.head-card { margin-bottom: 16rpx; }
.freight-num { font-size: 40rpx; font-weight: 700; color: #f59e0b; }
.head-card .foot { margin-top: 16rpx; }
.foot-actions { display: flex; gap: 12rpx; flex-wrap: wrap; }
.mini-btn {
  font-size: 24rpx; color: #fff; background: #3a6df0;
  border-radius: 999rpx; padding: 10rpx 22rpx;
}
.mini-ghost { color: #4b5563; background: #eef1f6; }
.right-tools { display: flex; align-items: center; gap: 10rpx; }
.mini-btn.tiny { font-size: 21rpx; padding: 6rpx 16rpx; background: #eef1f6; color: #4b5563; }
.btn-danger-on { background: #fde8e8; color: #dc2626; }
.pkg-actions { display: flex; gap: 12rpx; margin-top: 18rpx; flex-wrap: wrap; }
.pkg-actions .danger { background: #fde8e8; color: #dc2626; }
.sec-title { font-size: 28rpx; font-weight: 600; color: #1f2733; }

.tabs { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.tab {
  flex: 1; text-align: center; font-size: 26rpx; color: #6b7484;
  background: #fff; border-radius: 999rpx; padding: 14rpx 0;
  box-shadow: 0 2rpx 10rpx rgba(31, 42, 60, 0.04);
}
.tab-on { background: #3a6df0; color: #fff; font-weight: 600; }

.search-row { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.search-input {
  flex: 1; background: #fff; border-radius: 14rpx; height: 76rpx; padding: 0 24rpx; font-size: 26rpx;
  box-shadow: 0 4rpx 18rpx rgba(31, 42, 60, 0.05);
}
.search-btn { background: #3a6df0; color: #fff; font-size: 26rpx; border-radius: 14rpx; padding: 16rpx 30rpx; }

.count-line { font-size: 24rpx; color: #9a9fa8; margin-bottom: 14rpx; }

.p-card { margin-bottom: 14rpx; }
.p-card .muted { display: block; margin-top: 8rpx; font-size: 24rpx; }
.p-no { font-size: 28rpx; font-weight: 600; word-break: break-all; }

.ship-card { margin-bottom: 16rpx; }
.s-label { font-size: 30rpx; font-weight: 700; }
.meta-row { display: flex; flex-wrap: wrap; gap: 18rpx; margin-top: 12rpx; }
.meta { font-size: 23rpx; color: #6b7484; }

.fee-row { display: flex; margin-top: 16rpx; padding-top: 14rpx; border-top: 2rpx solid #f0f2f5; }
.fee-item { flex: 1; display: flex; flex-direction: column; }
.fee-num { font-size: 32rpx; font-weight: 600; color: #3a6df0; }
.fee-unit { font-size: 22rpx; color: #6b7484; font-weight: 400; }
.fee-lab { font-size: 22rpx; color: #9a9fa8; margin-top: 4rpx; }
.fee-freight { color: #f59e0b; }

/* ---------- 已付款标记 ---------- */
.pay-row { display: flex; align-items: center; margin-top: 14rpx; }
.paid-badge {
  font-size: 22rpx; color: #1a8a3c; background: #eafaf0;
  padding: 6rpx 16rpx; border-radius: 999rpx; font-weight: 600;
}
.paid-info { font-size: 21rpx; color: #9a9fa8; margin-left: 14rpx; }
.paid-unmark {
  margin-left: auto; font-size: 22rpx; color: #6b7484;
  padding: 6rpx 18rpx; border: 2rpx solid #e3e7ee; border-radius: 999rpx;
}
.paid-unmark.sm { font-size: 20rpx; padding: 4rpx 14rpx; }
.mark-paid-btn {
  margin-left: auto; font-size: 23rpx; color: #3a6df0; font-weight: 600;
  padding: 8rpx 24rpx; background: #eaf2ff; border-radius: 999rpx;
}

.w-row { display: flex; margin-top: 10rpx; }
.w-item { font-size: 22rpx; color: #9a9fa8; margin-right: 24rpx; }

.fold-row { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; padding-top: 14rpx; border-top: 2rpx solid #f0f2f5; }
.fold-text { font-size: 24rpx; color: #6b7484; }
.fold-arrow { font-size: 24rpx; color: #3a6df0; }
.fold-body { margin-top: 14rpx; padding-top: 14rpx; border-top: 2rpx dashed #e6eaf0; }
.item-row { padding: 6rpx 0; }
.item-no { font-size: 24rpx; color: #6b7484; word-break: break-all; }
.fold-hint { font-size: 22rpx; color: #b9bfc9; }

.load-more { text-align: center; color: #9a9fa8; font-size: 23rpx; padding: 20rpx 0 40rpx; }
.sk-card { height: 160rpx; border-radius: 14rpx; margin-bottom: 16rpx; background: #eef1f6; }

/* 状态标签 */
.tag { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 999rpx; font-weight: 600; background: #f1f3f6; color: #8a93a3; }
.tag-green { background: #e8f7ef; color: #16a34a; }
.tag-orange { background: #fff4e3; color: #f59e0b; }
.tag-red { background: #fdeaea; color: #e23c3c; }
.tag-gray { background: #f1f3f6; color: #8a93a3; }
.tag-blue { background: #eaf0ff; color: #3a6df0; }

/* —— 代客确认面板 —— */
.mask {
  position: fixed; inset: 0; background: rgba(15, 23, 42, 0.5);
  z-index: 50; display: flex; align-items: flex-end;
}
.panel {
  width: 100%; max-height: 82vh; overflow-y: auto;
  background: #f5f6fa; border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.panel-title { font-size: 32rpx; font-weight: 700; color: #1f2733; }
.panel-sub { display: block; font-size: 22rpx; color: #9a9fa8; margin-top: 6rpx; }
.sec-label { display: block; font-size: 24rpx; color: #6b7484; margin: 24rpx 0 10rpx; }

.opt-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.opt {
  font-size: 24rpx; color: #6b7484; background: #fff;
  border-radius: 10rpx; padding: 12rpx 22rpx;
}
.opt-on { background: #3a6df0; color: #fff; font-weight: 600; }

.addr-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.addr-input {
  width: calc(50% - 6rpx); background: #fff; border-radius: 10rpx;
  height: 76rpx; padding: 0 20rpx; font-size: 25rpx; box-sizing: border-box;
}
.addr-line { width: 100%; }

.cand-list { max-height: 380rpx; background: #fff; border-radius: 12rpx; }
.cand { display: flex; align-items: center; gap: 14rpx; padding: 18rpx 22rpx; border-bottom: 2rpx solid #f4f6f9; }
.cand-on { background: #f0f6ff; }
.cand-check { font-size: 30rpx; color: #3a6df0; }
.cand-no { flex: 1; font-size: 25rpx; word-break: break-all; }

.remark-input { background: #fff; border-radius: 10rpx; height: 76rpx; padding: 0 20rpx; font-size: 25rpx; box-sizing: border-box; }
.mt { margin-top: 28rpx; }
.btn-primary { background: #3a6df0; color: #fff; font-size: 30rpx; border-radius: 14rpx; }

/* 优惠券卡片 */
.coupon-card { background: linear-gradient(135deg, #fff7ed, #fff); }
.coupon-list { margin-top: 16rpx; }
.coupon-row { display: flex; align-items: center; gap: 14rpx; padding: 16rpx 0; border-top: 2rpx solid #f4f6f9; }
.coupon-info { flex: 1; display: flex; flex-direction: column; }
.coupon-code { font-size: 27rpx; font-weight: 600; color: #1f2733; }
.coupon-info .muted { font-size: 22rpx; margin-top: 4rpx; }
.mini-btn.tiny { font-size: 21rpx; padding: 6rpx 16rpx; background: #eef1f6; color: #4b5563; }

/* 运费明细弹层 */
.fee-list { margin: 18rpx 0; max-height: 50vh; }
.fee-line { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; border-bottom: 2rpx solid #f4f6f9; }
.fee-label { font-size: 26rpx; color: #1f2733; }
.fee-amt { font-size: 28rpx; font-weight: 700; color: #f59e0b; }
.fee-total { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; font-size: 28rpx; font-weight: 600; }
.modal-btn-row { display: flex; gap: 16rpx; }
.modal-btn-row .btn-primary { flex: 1; }
.btn-plain { flex: 1; background: #f1f3f7; color: #4b5563; font-size: 30rpx; border-radius: 14rpx; }
