.page { padding: 24rpx 24rpx 48rpx; background: #eef1f6; min-height: 100vh; }
.hero { background: linear-gradient(135deg, #16243f, #243b5e); border-radius: 24rpx; padding: 36rpx 30rpx; margin-bottom: 24rpx; color: #fff; }
.hero-title { font-size: 40rpx; font-weight: 700; }
.hero-sub { font-size: 23rpx; opacity: 0.75; margin-top: 12rpx; line-height: 1.6; }
.card { background: #fff; border-radius: 18rpx; padding: 26rpx 24rpx; margin-bottom: 16rpx; box-shadow: 0 4rpx 16rpx rgba(22,36,63,0.06); }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.p-no { font-size: 30rpx; font-weight: 700; color: #16243f; }
.muted { display: block; font-size: 23rpx; color: #8a93a3; margin-top: 10rpx; }
.tag { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 999rpx; }
.tag-orange { background: #fff4e3; color: #f59e0b; }
.act-row { display: flex; gap: 12rpx; margin-top: 22rpx; }
.act-btn { flex: 1; text-align: center; font-size: 24rpx; color: #4b5563; background: #eef1f6; border-radius: 12rpx; padding: 14rpx 0; }
.act-btn.primary { background: #3a6df0; color: #fff; }
.act-btn.danger { background: #fde8e8; color: #dc2626; }
.notice { font-size: 23rpx; color: #8a93a3; line-height: 1.7; }
.skeleton { background: #e6e9ee; border-radius: 18rpx; }
.sk-block { height: 200rpx; }
.mask { position: fixed; inset: 0; background: rgba(16,24,40,0.55); z-index: 50; display: flex; align-items: flex-end; }
.panel { width: 100%; background: #fff; border-radius: 28rpx 28rpx 0 0; padding: 32rpx 28rpx calc(60rpx + env(safe-area-inset-bottom)); max-height: 80vh; overflow-y: auto; flex-shrink: 0; }
.panel-title { font-size: 32rpx; font-weight: 700; color: #16243f; }
.panel-sub { display: block; font-size: 23rpx; color: #8a93a3; margin: 12rpx 0 20rpx; }
.search-row { display: flex; gap: 12rpx; }
.search-input { flex: 1; min-width: 0; background: #f5f7fa; border-radius: 12rpx; height: 80rpx; padding: 0 20rpx; font-size: 26rpx; box-sizing: border-box; }
.search-btn { background: #3a6df0; color: #fff; border-radius: 12rpx; height: 80rpx; line-height: 80rpx; padding: 0 26rpx; font-size: 26rpx; }
.cand-list { max-height: 50vh; margin-top: 20rpx; }
.cand { padding: 22rpx 10rpx; border-bottom: 2rpx solid #f0f2f5; }
.cand-name { font-size: 28rpx; font-weight: 600; color: #1f2733; }
.fold-hint { display: block; font-size: 24rpx; color: #9a9fa8; padding: 30rpx 0; text-align: center; }
