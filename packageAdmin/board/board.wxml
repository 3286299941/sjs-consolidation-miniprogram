<view class="page">
  <view class="card head-card">
    <text class="title">客户意向看板</text>
    <text class="subtitle">批次 ID：{{batchId || '未选择'}} ｜ 汇总本批次所有客户的发货意向</text>
  </view>

  <view wx:if="{{!batchId}}" class="card">
    <text class="subtitle">请从「批次管理」点击某批次的意向看板进入。</text>
    <button class="btn-primary mt" bindtap="goBack">返回批次列表</button>
  </view>

  <block wx:else>
    <view class="card">
      <text class="title">汇总统计</text>
      <view class="stat-grid">
        <view class="stat-box"><text class="num">{{summary.total}}</text><text class="lab">客户总数</text></view>
        <view class="stat-box"><text class="num">{{summary.all}}</text><text class="lab">全发</text></view>
        <view class="stat-box"><text class="num">{{summary.normal_only}}</text><text class="lab">只发普货</text></view>
        <view class="stat-box"><text class="num">{{summary.sensitive_only}}</text><text class="lab">只发敏货</text></view>
        <view class="stat-box"><text class="num">{{summary.none}}</text><text class="lab">不发货</text></view>
        <view class="stat-box"><text class="num">{{summary.confirmed}}</text><text class="lab">已确认</text></view>
      </view>
      <view class="stat-grid">
        <view class="stat-box"><text class="num">{{summary.pooled}}</text><text class="lab">拼邮发货</text></view>
        <view class="stat-box"><text class="num">{{summary.direct}}</text><text class="lab">单独地址</text></view>
        <view class="stat-box"><text class="num">{{summary.none_delivery}}</text><text class="lab">本周不发</text></view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="skeleton sk-block"></view>

    <block wx:else>
      <view wx:for="{{list}}" wx:key="customer_id" class="card row-card">
        <view class="row-between">
          <view class="col flex-1">
            <text class="strong">{{item.customer_name}}</text>
            <text class="muted">{{item.customer_no}} · 共 {{item.package_count}} 件{{item.nature_known ? '（普 ' + item.normal_count + ' / 敏 ' + item.sensitive_count + '）' : '（普 / 敏 打包时判定）'}}</text>
            <text class="muted delivery-line">{{item.intentSummary}}</text>
          </view>
          <view class="tag {{item.confirmed ? 'tag-green' : 'tag-orange'}}">{{item.confirmed ? '已确认' : '待确认'}}</view>
        </view>
        <!-- 单独地址：展示客户填写的信息，供核重与走单 -->
        <view wx:if="{{item.delivery_type === 'direct'}}" class="direct-box">
          <text class="direct-line">收件人：{{item.address_name || '—'}}　{{item.address_phone || '—'}}</text>
          <text class="direct-line">{{item.address_line || '—'}}</text>
          <text class="direct-line">邮编：{{item.address_zip || '—'}}</text>
          <text class="direct-line warn">打包称重后需核验是否满 12 kg</text>
        </view>
        <view wx:if="{{item.remark}}" class="remark-box">
          <text class="remark-label">客户备注</text>
          <text class="remark-text">{{item.remark}}</text>
        </view>
        <view class="row-between foot">
          <text class="muted">更新于 {{item.updated_at || '—'}}</text>
          <text class="muted">{{item.confirmed ? '仓库已确认' : '待确认'}}</text>
        </view>
      </view>

      <empty-state wx:if="{{list.length === 0}}" text="本批次暂无客户意向" mark="□" />
    </block>

    <button class="btn-primary mt" disabled="{{confirming || list.length === 0}}" bindtap="onConfirm">
      {{confirming ? '确认中...' : '确认意向并生成待打包清单'}}
    </button>

    <view class="card notice">
      <text class="strong">与操作端的衔接</text>
      <view class="notice-line">· 确认后生成「待打包清单」：哪些包裹应指定到本批次，由操作端人工核对。</view>
      <view class="notice-line">· 清单仅为输入参考，不会自动改写 incoming_packages.status 或锁定批次。</view>
      <view class="notice-line">· 导出 / 推送操作端：策划案 6.2 提及，当前 API 草案未定义接口，留待下一轮。</view>
    </view>
  </block>
</view>
