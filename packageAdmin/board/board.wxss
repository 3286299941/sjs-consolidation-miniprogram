.head-card .subtitle { display: block; margin-top: 12rpx; }
.stat-grid { display: flex; flex-wrap: wrap; margin-top: 24rpx; }
.stat-box {
  width: calc(33.33% - 12rpx); margin: 0 12rpx 16rpx 0; padding: 20rpx 0;
  background: #f7f9fc; border-radius: 12rpx;
  display: flex; flex-direction: column; align-items: center;
}
.stat-box:nth-child(3n) { margin-right: 0; }
.num { font-size: 36rpx; font-weight: 600; color: #1f6feb; }
.lab { font-size: 22rpx; color: #6b7484; margin-top: 8rpx; }
.row-card .muted { margin-top: 10rpx; }
.foot { margin-top: 20rpx; padding-top: 18rpx; border-top: 2rpx solid #edf0f4; }
.sk-block { height: 260rpx; border-radius: 16rpx; }
.notice { background: #fffaf1; margin-top: 24rpx; }
.notice-line { font-size: 24rpx; color: #8a6a35; line-height: 1.9; margin-top: 10rpx; }
.mt { margin-top: 8rpx; }

/* 第四轮：配送方式与单独地址 */
.delivery-line { display: block; margin-top: 8rpx; color: #1f6feb; }
.direct-box {
  margin-top: 20rpx; padding: 18rpx; background: #f7f9fc;
  border-radius: 10rpx; border-left: 6rpx solid #1f6feb;
}
.direct-line { display: block; font-size: 23rpx; color: #4a5462; line-height: 1.7; }
.direct-line.warn { color: #d98209; }

/* 第五轮：客户备注 */
.remark-box {
  margin-top: 16rpx; padding: 16rpx; background: #fffaf1;
  border-radius: 10rpx; border-left: 6rpx solid #f59a23;
}
.remark-label { display: block; font-size: 22rpx; color: #a56a10; font-weight: 600; }
.remark-text { display: block; font-size: 24rpx; color: #6b4a12; line-height: 1.7; margin-top: 6rpx; }
