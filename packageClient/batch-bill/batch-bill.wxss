.page { padding: 24rpx 24rpx 40rpx; background: #eef1f6; min-height: 100vh; }

.hero {
  background: linear-gradient(135deg, #16243f, #243b5e);
  border-radius: 24rpx; padding: 36rpx 32rpx; margin-bottom: 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(22, 36, 63, 0.28);
}
.hero-title { font-size: 38rpx; font-weight: 700; color: #fff; }
.hero-sub { margin-top: 10rpx; display: block; font-size: 23rpx; color: rgba(255, 255, 255, 0.85); }

.empty-hint { padding: 40rpx 24rpx; text-align: center; font-size: 24rpx; color: #9a9fa8; background: #fff; border-radius: 18rpx; }
.sk-block { height: 220rpx; border-radius: 20rpx; background: #eef1f6; }

.grp-card { background: #fff; border-radius: 18rpx; padding: 8rpx 24rpx; margin-bottom: 16rpx; box-shadow: 0 4rpx 18rpx rgba(31, 42, 60, 0.05); }
.grp-head { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0 12rpx; }
.grp-tag { font-size: 24rpx; font-weight: 700; padding: 4rpx 18rpx; border-radius: 999rpx; }
.grp-head.normal .grp-tag { background: #eaf0ff; color: #3a6df0; }
.grp-head.sensitive .grp-tag { background: #fef3e2; color: #d97706; }
.grp-rate { font-size: 23rpx; color: #9a9fa8; }

.grp-body { padding: 8rpx 0 16rpx; }
.grp-row { display: flex; align-items: center; justify-content: space-between; padding: 10rpx 0; font-size: 26rpx; color: #4b5563; border-top: 2rpx solid #f6f8fb; }
.grp-row.strong { font-weight: 700; color: #1f2733; }
.grp-row .amt { font-weight: 700; color: #f59e0b; }
.grp-row .pending { font-weight: 700; color: #d97706; }
.grp-state { margin-top: 12rpx; text-align: center; font-size: 24rpx; font-weight: 600; padding: 10rpx; border-radius: 12rpx; }
.grp-state.paid { background: #eafaf0; color: #16a34a; }
.grp-state.unpaid { background: #fef3e2; color: #d97706; }

.total-card { background: #fff; border-radius: 18rpx; padding: 24rpx; margin-top: 4rpx; box-shadow: 0 4rpx 18rpx rgba(31, 42, 60, 0.05); }
.total-row { display: flex; align-items: center; justify-content: space-between; padding: 10rpx 0; font-size: 27rpx; color: #4b5563; }
.total-amt { font-size: 34rpx; font-weight: 700; color: #f59e0b; }
.pending { color: #d97706; font-weight: 700; }
