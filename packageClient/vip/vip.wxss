.page { padding: 24rpx; box-sizing: border-box; }

.hero {
  padding: 32rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #1f2733 0%, #2c3a4d 100%);
  color: #fff;
  margin-bottom: 24rpx;
}
.hero-title { font-size: 36rpx; font-weight: 700; }
.hero-sub { margin-top: 10rpx; font-size: 24rpx; opacity: 0.82; line-height: 1.7; }

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 39, 51, 0.04);
}

.batch-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.batch-no { font-size: 30rpx; font-weight: 700; color: #1f2733; }
.head-right { display: flex; align-items: center; }

.tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
}
.tag-green { background: #e7f6ec; color: #1f9d55; }
.tag-gray { background: #f0f1f4; color: #8a909c; }

.mini-btn {
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  margin-left: 12rpx;
}
.ghost { background: #f2f5f9; color: #1f6feb; }

.batch-sub { display: block; margin-top: 10rpx; font-size: 24rpx; color: #9a9fa8; }

.stat-grid {
  display: flex;
  margin-top: 22rpx;
  border-top: 1rpx solid #eef1f6;
  padding-top: 20rpx;
}
.stat-cell { flex: 1; text-align: center; }
.stat-num { display: block; font-size: 34rpx; font-weight: 700; color: #1f2733; }
.stat-lab { display: block; margin-top: 6rpx; font-size: 22rpx; color: #9a9fa8; }
.stat-blue { color: #1f6feb; }

.foot { margin-top: 20rpx; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.muted { font-size: 24rpx; color: #9a9fa8; }

.empty { text-align: center; color: #9a9fa8; font-size: 26rpx; }
.notice { background: #f5f7fa; font-size: 24rpx; color: #6b7484; line-height: 1.8; }
.sk-block { height: 220rpx; border-radius: 20rpx; background: #eef1f6; }
.admin-banner {
  background: #fff7e6; color: #ad6800; font-size: 24rpx;
  padding: 16rpx 24rpx; border-radius: 16rpx; margin-bottom: 20rpx;
  border: 1rpx solid #ffe0a3;
}
